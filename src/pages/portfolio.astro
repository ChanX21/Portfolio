---
import "../styles/global.css";
import {
  clientPortfolio,
  fundedPortfolio,
  hackathonPortfolio,
  majorPortfolio
} from "../content/portfolio";
import { profile } from "../content/profile";

const sections = [
  ["Major Projects", majorPortfolio],
  ["Funded Project", fundedPortfolio],
  ["Client Delivered Project", clientPortfolio],
  ["Hackathon Projects", hackathonPortfolio]
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Portfolio of major and hackathon projects by Chanchal Delson."
    />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <title>Portfolio | Chanchal Delson</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Chanchal Delson home">
        <img src="/assets/signature.png" alt="Chanchal" />
      </a>
      <nav aria-label="Primary navigation">
        <a href="/">Home</a>
        <a href="/#work">Work</a>
        <a href="/#projects">Projects</a>
        <a href="/portfolio/">Portfolio</a>
        <a href="/#writing">Writing</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section class="portfolio-hero section">
        <p class="eyebrow">Portfolio</p>
        <h1>Projects built through engineering progress and product pressure.</h1>
        <p class="lede">
          Major systems, wallet infrastructure, protocol work, and hackathon builds
          across AI, backend, and blockchain ecosystems.
        </p>
      </section>

      {sections.map(([title, items]) => (
        <>
          <section class="section portfolio-section">
            <div class="section-heading compact">
              <p class="section-kicker">{title}</p>
              <h2>{title === "Major Projects" ? "The core systems" : title}</h2>
            </div>
            <div class="portfolio-grid">
              {items.map((item) => (
                <article class="portfolio-card">
                  {item.links?.find((link) => link.label.toLowerCase().includes("video")) ? (
                    <a
                      class="media-link"
                      href={item.links.find((link) => link.label.toLowerCase().includes("video"))!.href}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={`Play ${item.title} video`}
                    >
                      <img class="portfolio-media" src={item.image} alt={`${item.title} visual`} loading="lazy" />
                      <span>Play video</span>
                    </a>
                  ) : (
                    <img class="portfolio-media" src={item.image} alt={`${item.title} visual`} loading="lazy" />
                  )}
                  <div>
                    <p>{item.group}</p>
                    <h3>{item.title}</h3>
                    <span>{item.summary}</span>
                    {item.links && (
                      <div class="card-actions">
                        {item.links.map((link) => (
                          <a class="card-link" href={link.href} target="_blank" rel="noreferrer">
                            {link.label}
                          </a>
                        ))}
                      </div>
                    )}
                    <div class="tags">
                      {item.tags.map((tag) => <span>{tag}</span>)}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>

          {title === "Funded Project" && (
            <section class="section portfolio-section">
              <div class="section-heading compact">
                <p class="section-kicker">Public contributions</p>
                <h2>Open source work</h2>
              </div>
              <article class="oss-card">
                <img src="/assets/agent-opfor-pr.jpeg" alt="Agent Opfor open source pull request" loading="lazy" />
                <div>
                  <p>Agent Opfor / KeyValueSoftwareSystems</p>
                  <h3>First non-collaborator PR to Agent Opfor</h3>
                  <span>
                    Contributed to an OSS AI red-teaming tool for testing prompts, tools, MCP, memory, and multi-turn agent behavior with auditable OWASP-mapped reports.
                  </span>
                  <div class="card-actions">
                    <a class="card-link" href="https://github.com/KeyValueSoftwareSystems/agent-opfor" target="_blank" rel="noreferrer">
                      GitHub repo
                    </a>
                    <a class="card-link" href="https://x.com/ChanchalDelson/status/2074547925947207992" target="_blank" rel="noreferrer">
                      X post
                    </a>
                  </div>
                  <div class="tags">
                    <span>OSS</span>
                    <span>AI red-teaming</span>
                    <span>MCP</span>
                    <span>security</span>
                  </div>
                </div>
              </article>
            </section>
          )}
        </>
      ))}
    </main>

    <footer id="contact" class="site-footer">
      <div>
        <p class="section-kicker">Contact</p>
        <h2>Bring the system brief. I will map the architecture.</h2>
        <a class="email-link" href={`mailto:${profile.email}`}>{profile.email}</a>
        <p class="muted-contact">{profile.phone}</p>
      </div>
      <div class="footer-links">
        {profile.links.map(([label, href]) => (
          <a href={href} target="_blank" rel="noreferrer">{label}</a>
        ))}
      </div>
    </footer>
  </body>
</html>
