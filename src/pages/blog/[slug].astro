---
import "../../styles/global.css";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((post) => post.data.published)
    .map((post) => ({
      params: { slug: post.id.replace(/\.md$/, "") },
      props: { post }
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={post.data.excerpt} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <title>{post.data.title} | Chanchal Delson</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Chanchal Delson home">
        <img src="/assets/signature.png" alt="Chanchal" />
      </a>
      <nav aria-label="Primary navigation">
        <a href="/#work">Work</a>
        <a href="/#projects">Projects</a>
        <a href="/portfolio/">Portfolio</a>
        <a href="/#writing">Writing</a>
      </nav>
    </header>
    <main class="article-shell">
      <a class="back-link" href="/#writing">Back to writing</a>
      <article class="article">
        <p class="section-kicker">{post.data.date}</p>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.excerpt}</p>
        <Content />
      </article>
    </main>
  </body>
</html>
